# Dependencies
node_modules
.pnp
.pnp.js

# Builds
dist
build
out
.next
coverage

# Env / secrets — NEVER commit these
.env
.env.local
.env*.local
*.pem

# Editor / OS
.DS_Store
*.local
.vscode/*
!.vscode/extensions.json
.idea

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Windows Git Bash safety: prevent accidental NUL device files
nul

# Local agent state (settings, worktrees) — but DO commit .claude/skills/,
# it's the optional cross-tool skill mirror from Task E.
.claude/*
!.claude/skills/
# ...and the same path without the trailing slash: here .claude/skills is a
# symlink to .agents/skills (the canonical location), and git records a symlink
# as a file, which the directory-only negation above would not re-include.
!.claude/skills
